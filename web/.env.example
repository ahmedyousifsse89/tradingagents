# Vercel project environment variables (all server-side; none are NEXT_PUBLIC_,
# so nothing here reaches the browser).

# Public URL of the Railway service, no trailing slash.
TRADINGAGENTS_API_URL=https://your-bot.up.railway.app

# Must match TRADINGAGENTS_API_TOKEN on Railway.
TRADINGAGENTS_API_TOKEN=

# Password you type on the dashboard login screen (min 8 characters).
DASHBOARD_PASSWORD=

# Signs the session cookie (min 24 characters). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
