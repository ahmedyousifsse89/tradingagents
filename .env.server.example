# Environment for the deployed bot (Railway service variables).
# Copy the values you need; every execution switch defaults to "moves no money".

# ---- LLM provider (pick one) ----------------------------------------
OPENAI_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini

# ---- Control API ----------------------------------------------------
# Required. The API refuses to start without it. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
TRADINGAGENTS_API_TOKEN=

# Only needed if a browser calls the API directly. The shipped dashboard
# proxies server-side, so leave this empty.
TRADINGAGENTS_CORS_ORIGINS=

# ---- Alpaca ---------------------------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ---- Execution gates ------------------------------------------------
# Money moves only when EXECUTION_ENABLED=true AND EXECUTION_DRY_RUN=false.
# Reaching the LIVE account additionally needs ALPACA_LIVE=true AND
# ALPACA_ALLOW_LIVE=true. Start with all of these at their defaults.
TRADINGAGENTS_EXECUTION_ENABLED=false
TRADINGAGENTS_EXECUTION_DRY_RUN=true
TRADINGAGENTS_ALPACA_LIVE=false
# TRADINGAGENTS_ALPACA_ALLOW_LIVE=true

# ---- Position and order caps ----------------------------------------
TRADINGAGENTS_MAX_POSITION_WEIGHT=0.10
TRADINGAGENTS_MAX_GROSS_EXPOSURE=0.80
TRADINGAGENTS_MIN_ORDER_NOTIONAL=10
TRADINGAGENTS_MAX_ORDERS_PER_DAY=20

# ---- Kill switch ----------------------------------------------------
TRADINGAGENTS_KILL_SWITCH_ENABLED=true
TRADINGAGENTS_MAX_TOTAL_DRAWDOWN=0.15
TRADINGAGENTS_MAX_DAILY_DRAWDOWN=0.05
TRADINGAGENTS_FLATTEN_ON_HALT=false

# ---- Scheduler ------------------------------------------------------
# Cron is evaluated in TRADINGAGENTS_SCHEDULE_TIMEZONE. The default fires at
# 13:30 UTC on weekdays, shortly before the US open.
TRADINGAGENTS_SCHEDULE_ENABLED=false
TRADINGAGENTS_SCHEDULE_CRON=30 13 * * 1-5
TRADINGAGENTS_SCHEDULE_TIMEZONE=UTC
# Caps cost and duration of one pass: a full analysis is many LLM calls.
TRADINGAGENTS_RUN_MAX_TICKERS=10

# ---- Persistence (set by Dockerfile.server; override only if needed) --
# TRADINGAGENTS_CACHE_DIR=/data/cache
# TRADINGAGENTS_RESULTS_DIR=/data/logs
# TRADINGAGENTS_MEMORY_LOG_PATH=/data/memory/trading_memory.md
